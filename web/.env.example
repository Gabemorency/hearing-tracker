# Copy to .env.local for local dev, and set the same two in Vercel's
# project settings (Environment Variables) for deployed builds.
#
# Both are safe to expose to the browser (NEXT_PUBLIC_) — they only grant
# the access already allowed by the public-read RLS policies in
# supabase/migrations/0001_init.sql. The service_role key does NOT belong
# in this app; only the Python scraper (running in GitHub Actions) uses it.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
